# PayPilot AI ACCESS - Environment Configuration Template
# Copy this file to .env and fill in with your real keys.
# NEVER commit the .env file to git.

# Channel3 API Key (Promo code: PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=your_channel3_api_key_here

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# PayPal Sandbox Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENV=sandbox

# Offline Testing Flag (1 = use local test fixtures only, 0 = live external calls)
OFFLINE_TESTS=0

# Rate Limiting & Safety Quotas
RATE_LIMIT_PER_HOUR=30
DAILY_SEARCH_CAP=1500
